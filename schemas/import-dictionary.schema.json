{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.dragonheir.tools/schemas/import-dictionary.schema.json",
  "title": "Dragonheir Import and OCR Alias Dictionary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "gameDataVersionId", "sources", "normalization", "entities", "collisions"],
  "properties": {
    "schemaVersion": {"type": "string", "pattern": "^0\\.1\\.0"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "gameDataVersionId": {"type": "string"},
    "sources": {"type": "array", "items": {"type": "string"}},
    "normalization": {"type": "string"},
    "entities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stat", "slot", "rarity", "hero", "equipment", "artifact", "set"],
      "properties": {
        "stat": {"$ref": "#/$defs/entityArray"},
        "slot": {"$ref": "#/$defs/entityArray"},
        "rarity": {"$ref": "#/$defs/entityArray"},
        "hero": {"$ref": "#/$defs/entityArray"},
        "equipment": {"$ref": "#/$defs/entityArray"},
        "artifact": {"$ref": "#/$defs/entityArray"},
        "set": {"$ref": "#/$defs/entityArray"}
      }
    },
    "collisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "normalized", "matches"],
        "properties": {
          "kind": {"enum": ["stat", "slot", "rarity", "hero", "equipment", "artifact", "set"]},
          "normalized": {"type": "string"},
          "matches": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "alias"],
              "properties": {"id": {"type": "string"}, "alias": {"type": "string"}}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "entityArray": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "externalId", "aliases", "verification"],
        "properties": {
          "id": {"type": "string"},
          "externalId": {"type": ["integer", "string", "null"]},
          "aliases": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "verification": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    }
  }
}
