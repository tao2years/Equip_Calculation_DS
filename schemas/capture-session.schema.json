{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.dragonheir.tools/schemas/capture-session.schema.json",
  "title": "Dragonheir Guided Capture Session Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sessionId", "planId", "startedAt", "completedAt", "status", "sourceMethod", "privacy", "device", "captures", "stepResults"],
  "properties": {
    "schemaVersion": {"const": "0.1.0"},
    "sessionId": {"type": "string", "minLength": 1},
    "planId": {"type": "string", "minLength": 1},
    "startedAt": {"type": "string", "format": "date-time"},
    "completedAt": {"type": ["string", "null"], "format": "date-time"},
    "status": {"enum": ["running", "partial", "complete"]},
    "sourceMethod": {"const": "emulator_adb_user_initiated_screenshot"},
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["localOnly", "uploadPerformed"],
      "properties": {"localOnly": {"const": true}, "uploadPerformed": {"const": false}}
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serial", "model", "product"],
      "properties": {
        "serial": {"type": "string", "minLength": 1},
        "model": {"type": ["string", "null"]},
        "product": {"type": ["string", "null"]}
      }
    },
    "captures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "stepId", "captureType", "capturedAt", "localPath", "metadataPath", "mediaType", "byteLength", "sha256"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "stepId": {"type": "string"},
          "captureType": {"type": "string"},
          "capturedAt": {"type": "string", "format": "date-time"},
          "localPath": {"type": "string"},
          "metadataPath": {"type": "string"},
          "mediaType": {"const": "image/png"},
          "byteLength": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "stepResults": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stepId", "captured", "minimumCaptures", "complete"],
        "properties": {
          "stepId": {"type": "string"},
          "captured": {"type": "integer", "minimum": 0},
          "minimumCaptures": {"type": "integer", "minimum": 0},
          "complete": {"type": "boolean"}
        }
      }
    }
  }
}
