{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.dragonheir.tools/schemas/artifact-static-effect-audit.schema.json",
  "title": "Artifact Static Effect Audit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "gameDataVersionId", "parserVersion", "evidenceLevel", "counts", "compiledArtifacts", "limitations"],
  "properties": {
    "schemaVersion": {"const": "0.1.0"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "gameDataVersionId": {"type": "string"},
    "parserVersion": {"type": "string"},
    "evidenceLevel": {"type": "string"},
    "counts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "compiledArtifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifactDefinitionId", "name", "refinementLevels", "source"],
        "properties": {
          "artifactDefinitionId": {"type": "string"},
          "name": {"type": "string"},
          "refinementLevels": {"type": "array", "minItems": 1},
          "source": {"type": "object"}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
