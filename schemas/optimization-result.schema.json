{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.dragonheir.tools/schemas/optimization-result.schema.json",
  "title": "Dragonheir Optimization Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "snapshotId", "gameDataVersionId", "objective", "appliedConstraints", "impliedConstraints", "searched", "solver", "validCount", "maxima", "minima", "results"],
  "properties": {
    "schemaVersion": {"const": "0.3.0"},
    "requestId": {"type": "string"},
    "snapshotId": {"type": "string"},
    "gameDataVersionId": {"type": "string"},
    "objective": {"type": "object"},
    "appliedConstraints": {"type": "array", "items": {"$ref": "#/$defs/appliedConstraint"}},
    "impliedConstraints": {"type": "array", "items": {"$ref": "#/$defs/appliedConstraint"}},
    "searched": {"type": "integer", "minimum": 0},
    "solver": {
      "type": "object",
      "required": ["mode", "searchSpace", "evaluatedBuilds", "visitedNodes", "prunedByFeasibility", "prunedByScore", "topNExact", "validCountExact", "extremaExact"],
      "properties": {
        "mode": {"enum": ["exhaustive", "branch_and_bound", "heuristic_candidate_cap"]},
        "searchSpace": {"type": "integer", "minimum": 0},
        "reducedSearchSpace": {"type": "integer", "minimum": 0},
        "evaluatedBuilds": {"type": "integer", "minimum": 0},
        "visitedNodes": {"type": "integer", "minimum": 0},
        "prunedByFeasibility": {"type": "integer", "minimum": 0},
        "prunedByScore": {"type": "integer", "minimum": 0},
        "topNExact": {"type": "boolean"},
        "validCountExact": {"type": "boolean"},
        "extremaExact": {"type": "boolean"},
        "optimality": {"type": "string"},
        "candidateCounts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["slot", "before", "after"],
            "properties": {
              "slot": {"type": "string"}, "before": {"type": "integer", "minimum": 0}, "after": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "validCount": {"type": "integer", "minimum": 0},
    "maxima": {"type": "object", "additionalProperties": {"type": "number"}},
    "minima": {"type": "object", "additionalProperties": {"type": "number"}},
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rank", "score", "ownedArtifactId", "ownedGearIds", "stats", "setLabels", "heroBaseSource", "evidence"],
        "properties": {
          "rank": {"type": "integer", "minimum": 1},
          "score": {"type": "number"},
          "ownedArtifactId": {"type": "string"},
          "ownedGearIds": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "string"}},
          "stats": {"type": "object", "additionalProperties": {"type": "number"}},
          "setLabels": {"type": "array", "items": {"type": "string"}},
          "heroBaseSource": {"type": "string"},
          "artifactStatSource": {"enum": ["account_observed", "legacy_account_stats", "public_level_curve", "unavailable"]},
          "artifactStatWarnings": {"type": "array", "items": {"type": "string"}},
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifact", "artifactFieldEvidence", "gear"],
            "properties": {
              "artifact": {"type": "array", "items": {"$ref": "#/$defs/evidenceRef"}},
              "artifactFieldEvidence": {"type": "array", "items": {"$ref": "#/$defs/fieldEvidence"}},
              "gear": {
                "type": "array",
                "minItems": 6,
                "maxItems": 6,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["ownedItemId", "evidenceRefs", "fieldEvidence"],
                  "properties": {
                    "ownedItemId": {"type": "string"},
                    "evidenceRefs": {"type": "array", "items": {"$ref": "#/$defs/evidenceRef"}},
                    "fieldEvidence": {"type": "array", "items": {"$ref": "#/$defs/fieldEvidence"}}
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceFileSha256", "localName", "sequence", "captureType", "reviewStatus"],
      "properties": {
        "sourceFileSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "localName": {"type": ["string", "null"]},
        "sequence": {"type": ["integer", "null"], "minimum": 1},
        "captureType": {"type": ["string", "null"]},
        "reviewStatus": {"type": "string"}
      }
    },
    "boundingRect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "number", "minimum": 0},
        "y": {"type": "number", "minimum": 0},
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "fieldEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fieldPath", "sourceFileSha256", "rawText", "confidence", "boundingRects"],
      "properties": {
        "fieldPath": {"type": "string", "minLength": 1},
        "sourceFileSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "rawText": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "boundingRects": {"type": "array", "items": {"$ref": "#/$defs/boundingRect"}}
      }
    },
    "appliedConstraint": {
      "type": "object",
      "required": ["stat", "op", "value", "layer"],
      "properties": {
        "stat": {"type": "string"},
        "op": {"enum": [">=", "<=", "=", ">", "<"]},
        "value": {"type": "number"},
        "layer": {"enum": ["sheet", "conditional", "encounter"]},
        "source": {"type": "string"}
      }
    }
  }
}
