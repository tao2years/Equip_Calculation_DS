{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.dragonheir.tools/schemas/capture-plan.schema.json",
  "title": "Dragonheir Guided Capture Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planId", "channel", "description", "steps"],
  "properties": {
    "schemaVersion": {"const": "0.1.0"},
    "planId": {"type": "string", "minLength": 1},
    "channel": {"enum": ["emulator", "official_pc", "steam", "unknown"]},
    "description": {"type": "string", "minLength": 1},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "captureType", "minimumCaptures", "instructions", "completionEvidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
          "title": {"type": "string", "minLength": 1},
          "captureType": {"enum": ["unclassified", "hero_list", "hero_detail", "gear_list", "gear_detail", "artifact_list", "artifact_detail"]},
          "minimumCaptures": {"type": "integer", "minimum": 0},
          "instructions": {"type": "string", "minLength": 1},
          "completionEvidence": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
