{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.dragonheir.tools/schemas/layout-profile.schema.json",
  "title": "OCR Layout Extraction Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profileId", "channel", "clientBuild", "language", "gameDataVersionId", "referenceViewport", "recordId", "evidenceLevel", "limitations", "pages"],
  "properties": {
    "schemaVersion": {"const": "0.1.0"},
    "profileId": {"type": "string", "minLength": 1},
    "channel": {"type": "string", "minLength": 1},
    "clientBuild": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 1},
    "gameDataVersionId": {"type": "string", "minLength": 1},
    "referenceViewport": {
      "type": "object", "additionalProperties": false, "required": ["width", "height"],
      "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}
    },
    "recordId": {
      "type": "object", "additionalProperties": false, "required": ["strategy", "prefix"],
      "properties": {
        "strategy": {"enum": ["capture_hash", "content_fingerprint", "explicit_field"]},
        "prefix": {"type": "string", "minLength": 1},
        "field": {"type": "string", "minLength": 1}
      }
    },
    "evidenceLevel": {"enum": ["synthetic_fixture", "golden_screenshot_calibrated", "runtime_validated"]},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "pages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/page"}}
  },
  "$defs": {
    "region": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 1}, "y": {"type": "number", "minimum": 0, "maximum": 1},
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "field": {
      "type": "object", "additionalProperties": false, "required": ["target", "mode", "required"],
      "properties": {
        "target": {"type": "string", "minLength": 1}, "mode": {"enum": ["text", "integer", "dictionary", "constant"]},
        "required": {"type": "boolean"}, "region": {"$ref": "#/$defs/region"}, "dictionaryKind": {"type": "string"},
        "value": {}
      }
    },
    "statRow": {
      "type": "object", "additionalProperties": false, "required": ["labelRegion", "valueRegion", "required"],
      "properties": {
        "labelRegion": {"$ref": "#/$defs/region"}, "valueRegion": {"$ref": "#/$defs/region"},
        "dictionaryKind": {"type": "string"}, "required": {"type": "boolean"}
      }
    },
    "statGroup": {
      "type": "object", "additionalProperties": false, "required": ["target", "required", "rows"],
      "properties": {
        "target": {"enum": ["stats", "baseStats"]}, "required": {"type": "boolean"},
        "rows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/statRow"}}
      }
    },
    "page": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "captureTypes", "classifier", "fields", "statGroups"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "kind": {"enum": ["hero", "gear", "artifact"]},
        "captureTypes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "classifier": {
          "type": "object", "additionalProperties": false, "required": ["requiredTexts"],
          "properties": {"requiredTexts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}
        },
        "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}},
        "statGroups": {"type": "array", "items": {"$ref": "#/$defs/statGroup"}}
      }
    }
  }
}
